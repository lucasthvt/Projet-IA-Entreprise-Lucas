# Copiez ce fichier en .env et remplissez-le. .env ne se commite JAMAIS.

# Qui sert le modèle : ollama (votre PC) | ovh | github | groq | mistral | google
#   ovh    : OVHcloud AI Endpoints, France, sans compte ni clé (2 requêtes par minute et par modèle)
#   ollama : sur votre PC — il faut un modèle qui sait appeler des outils, ex. qwen2.5:7b
FOURNISSEUR=ovh

# Vide = le modèle par défaut du fournisseur (voir FOURNISSEURS dans llm.py).
MODELE=

# La clé du fournisseur (inutile pour ollama et ovh). Une clé par fournisseur possible :
# CLE_GITHUB=…, CLE_GROQ=… — jamais la clé de l'un envoyée à l'autre.
CLE_API=

# Avec Ollama sur une autre machine ou dans Docker :
# OLLAMA_URL=http://localhost:11434

# Plongements (RAG en mode vecteurs) chez un autre fournisseur que FOURNISSEUR, ex. ovh :
# FOURNISSEUR_VECTEURS=ovh

# Prototype sur données FICTIVES uniquement : autorise un fournisseur hors politique de routage.
# Chaque appel concerné est marqué « derogation » dans journal/appels.jsonl.
DONNEES_FICTIVES=non

# Séance 26 : masquer noms, téléphones, e-mails et adresses avant d'envoyer un rapport au modèle.
PSEUDONYMISER=oui
